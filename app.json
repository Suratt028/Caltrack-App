{
  "expo": {
    "name": "CalTrack",
    "slug": "puednike",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "caltrack",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.caltrack",
      "infoPlist": {
        "NSCameraUsageDescription": "CalTrack ใช้กล้องเพื่อถ่ายรูปอาหารสำหรับให้ AI ช่วยประเมินแคลอรี่",
        "NSPhotoLibraryUsageDescription": "CalTrack ใช้คลังภาพเพื่อเลือกรูปอาหารสำหรับให้ AI ช่วยประเมินแคลอรี่"
      }
    },
    "android": {
      "package": "com.example.caltrack",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F5C56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "CalTrack ใช้กล้องเพื่อถ่ายรูปอาหารสำหรับให้ AI ช่วยประเมินแคลอรี่"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "1463652e-222e-4dba-b7f9-9b09ca23379e"
      }
    },
    "owner": "puednikes-team"
  }
}
