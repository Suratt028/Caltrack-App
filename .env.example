MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/caltrack?retryWrites=true&w=majority"
MONGODB_DB_NAME="caltrack"
# Signs login tokens. Use a long random value (at least 32 characters), e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
AUTH_SECRET=""
# Built-in admin account, created on first start. Change the password before deploying.
ADMIN_EMAIL="admin@caltrack.app"
ADMIN_PASSWORD=""
PORT=3001
# Time zone for admin reports and the daily scan quota.
REPORT_TIMEZONE="Asia/Bangkok"
# 10.0.2.2 only works on the Android emulator. For iOS simulators and real
# devices use your computer's LAN address, e.g. http://192.168.1.20:3001/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_IDS=""
APPLE_SERVICE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_OAUTH_CLIENT_IDS=""
APPLE_REDIRECT_URI=""
# รับ API key ฟรีได้ที่ https://aistudio.google.com/apikey
# Server-only: never prefix with EXPO_PUBLIC_ (those values are bundled into the app).
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_SCAN_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite"
